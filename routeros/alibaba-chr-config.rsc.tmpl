# =============================================================================
# MikroTik RouterOS v7 Configuration Script: Alibaba Cloud CHR (Side A)
# Topology: Alibaba Cloud (ap-southeast-5) <---> GCP (asia-southeast2)
# =============================================================================

# 1. Interface & IP Naming
/interface set [ find default-name=ether1 ] name=ether1-peering-wan comment="Alibaba Peering Subnet (WAN/EIP)"
/interface set [ find default-name=ether2 ] name=ether2-private comment="Alibaba Private Subnet 5a"

# 2. IPsec Profile & Proposal (IKEv2, AES-GCM-256, DH Group 14/19)
/ip ipsec profile add name=gcp-ikev2-profile dh-group=modp2048,ecp256 enc-algorithm=aes-256 hash-algorithm=sha256 prf-algorithm=sha256 lifetime=1d nat-traversal=yes
/ip ipsec proposal add name=gcp-ipsec-prop auth-algorithms="" enc-algorithms=aes-256-gcm lifetime=8h pfs-group=modp2048

# 3. IPsec Peer (Connect to GCP CHR Static Public IP)
/ip ipsec peer add name=peer-gcp-chr address=GCP_CHR_PUBLIC_IP/32 profile=gcp-ikev2-profile exchange-mode=ike2

# 4. IPsec Identity (Pre-Shared Key)
/ip ipsec identity add peer=peer-gcp-chr auth-method=pre-shared-key secret="YOUR_STRONG_PRESHARED_KEY"

# 5. IPIP / GRE Tunnel Interface over IPsec
/interface ipip add name=ipip-to-gcp local-address=10.151.127.250 remote-address=GCP_CHR_PRIVATE_OR_PUBLIC_IP ipsec-secret="YOUR_STRONG_PRESHARED_KEY" allow-fast-path=no comment="Tunnel to GCP CHR"
/ip address add address=10.254.254.1/30 interface=ipip-to-gcp network=10.254.254.0

# 6. BGP Configuration (RouterOS v7)
# Alibaba CHR ASN: 65534 | GCP CHR ASN: 65535
/routing bgp template set default disabled=no as=65534 router-id=10.151.127.250
/routing bgp connection add name=bgp-to-gcp as=65534 remote.address=10.254.254.2/32 remote.as=65535 local.role=ebgp local.address=10.254.254.1 templates=default connect=yes listen=yes output.network=10.151.64.0/18

# 7. NAT & Forwarding Rules
# Masquerade outbound internet traffic for spoke VPCs
/ip firewall nat add chain=srcnat out-interface=ether1-peering-wan action=masquerade comment="NAT Egress Internet"

# Bypass NAT for cross-cloud traffic to GCP (10.160.0.0/16)
/ip firewall nat add chain=srcnat dst-address=10.160.0.0/16 action=accept place-before=0 comment="Do NOT NAT traffic to GCP"
