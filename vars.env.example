# Copy to vars.env and fill in. vars.env is gitignored — it holds the PSK.
#
# Both ends of this tunnel are MikroTik CHR, and BOTH sit behind 1:1 NAT
# (Alibaba EIP and GCP external IP are not configured on any interface). That
# symmetry is what lets the traffic selectors be private<->private; see
# routeros/*.rsc.tmpl for why that matters.

# --- Alibaba side (MikroTik CHR "chr-peering") ---
ALI_PUBLIC_IP=8.215.24.90            # EIP, 1:1 NAT onto ether1
ALI_PEERING_IP=10.151.127.250        # ether1, peering vswitch — IPsec + GRE endpoint
ALI_PRIVATE_IP=10.151.74.100         # ether2, private vswitch
ALI_PRIVATE_SUBNET=10.151.74.0/24    # ether2 subnet, for the scoped masquerade rule
ALI_ASN=65531
ALI_SUPERNET=10.151.64.0/18          # whole Alibaba VPC

# --- GCP side (MikroTik CHR "chr-peering") ---
GCP_PUBLIC_IP=34.101.118.166         # static external IP, 1:1 NAT onto nic0/ether1
GCP_PEERING_IP=10.101.16.10          # ether1, nextops-peering-apse2-subnet
GCP_PRIVATE_IP=10.101.0.10           # ether2, nextops-prod-apse2-subnet
                                     # NOTE: GCP DHCP gives both NICs /32 masks and
                                     # gives ether2 NO gateway, so there is no
                                     # connected route for either subnet — the
                                     # supernet static route is mandatory here.
GCP_ASN=65532
GCP_SUPERNET=10.101.0.0/18           # NOTE: the Shared VPC is a /16. A /18 covers
                                     # prod (10.101.0.0/22) and peering only —
                                     # data/sandbox/infra (.64/.128/.192) are NOT
                                     # advertised and stay unreachable from Alibaba.

# --- Tunnel ---
# Link-local /30, deliberately away from 10.x so it cannot collide with either
# cloud's address plan. 169.254.169.254 (GCP metadata) is outside this /30.
ALI_TUNNEL_IP=169.254.100.1
GCP_TUNNEL_IP=169.254.100.2
TUNNEL_NETWORK=169.254.100.0

# MEASURE these, do not copy them. Across the live tunnel, from each CHR:
#   /ping <peer tunnel ip> size=<n> do-not-fragment count=3
# TUNNEL_MTU is the largest size that survives; TUNNEL_MSS is TUNNEL_MTU - 40.
# Deriving MSS from the GRE interface MTU instead is the trap that black-holes
# bulk TCP while leaving small requests working.
TUNNEL_MTU=1400
TUNNEL_MSS=1360

TIMEZONE=Asia/Jakarta

# --- Secret ---
# Generate: openssl rand -base64 32
IPSEC_PSK=CHANGE_ME
