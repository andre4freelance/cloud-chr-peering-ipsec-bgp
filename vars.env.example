# Copy to vars.env and fill in. vars.env is gitignored — it holds the PSKs.
#
# Multi-cloud MikroTik CHR Interconnect (Alibaba, GCP, Azure)
# All routers sit behind 1:1 NAT in dedicated peering subnets.

# --- Alibaba side (MikroTik CHR "chr-peering") ---
ALI_PUBLIC_IP=8.215.24.90            # EIP, 1:1 NAT onto ether1
ALI_PEERING_IP=10.151.63.250         # ether1, nextops-peering-ap-southeast-5a vswitch — IPsec + GRE endpoint
ALI_PRIVATE_IP=10.151.10.100         # ether2, nextops-private-ap-southeast-5a vswitch
ALI_PRIVATE_SUBNET=10.151.10.0/24    # ether2 subnet, for scoped masquerade rule
ALI_ASN=65531
ALI_SUPERNET=10.151.0.0/18           # whole NextOps Alibaba VPC (10.151.0.0/18)
ALI_HUB_SUPERNET=10.151.64.0/18      # ManagedService Hub VPC (optional transit)

# --- GCP side (MikroTik CHR "chr-peering") ---
GCP_PUBLIC_IP=34.101.118.166         # static external IP, 1:1 NAT onto nic0/ether1
GCP_PEERING_IP=10.101.16.10          # ether1, nextops-peering-apse2-subnet
GCP_PRIVATE_IP=10.101.0.10           # ether2, nextops-prod-apse2-subnet
GCP_PRIVATE_SUBNET=10.101.0.0/22     # ether2 subnet
GCP_ASN=65532
GCP_SUPERNET=10.101.0.0/18           # covers prod (10.101.0.0/22) and peering

# --- Azure side (MikroTik CHR "chr-peering") ---
AZURE_PUBLIC_IP=70.153.184.179       # pip-chr-peering, 1:1 NAT onto ether1
AZURE_PEERING_IP=10.126.63.250       # ether1, subnet-peering
AZURE_PRIVATE_IP=10.126.1.100        # ether2, subnet-private
AZURE_PRIVATE_SUBNET=10.126.1.0/24   # ether2 subnet
AZURE_ASN=65533
AZURE_SUPERNET=10.126.0.0/18         # whole Azure VNet

# --- Tunnel Segments (/30 Link-Local) ---
# Alibaba <-> GCP
ALI_GCP_TUNNEL_ALI_IP=169.254.100.1
ALI_GCP_TUNNEL_GCP_IP=169.254.100.2
ALI_GCP_TUNNEL_NETWORK=169.254.100.0

# Azure <-> GCP
AZURE_GCP_TUNNEL_AZURE_IP=169.254.101.1
AZURE_GCP_TUNNEL_GCP_IP=169.254.101.2
AZURE_GCP_TUNNEL_NETWORK=169.254.101.0

# Azure <-> Alibaba
AZURE_ALI_TUNNEL_AZURE_IP=169.254.102.1
AZURE_ALI_TUNNEL_ALI_IP=169.254.102.2
AZURE_ALI_TUNNEL_NETWORK=169.254.102.0

# Tunnel MTU and TCP MSS
TUNNEL_MTU=1400
TUNNEL_MSS=1360

TIMEZONE=Asia/Jakarta

# --- Secrets ---
IPSEC_PSK_ALI_GCP=CHANGE_ME
IPSEC_PSK_AZURE_GCP=CHANGE_ME
IPSEC_PSK_AZURE_ALI=CHANGE_ME
