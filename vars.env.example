# Copy to vars.env and fill in. vars.env is gitignored — it holds the PSKs and sensitive variables.
#
# Multi-cloud MikroTik CHR Interconnect (AWS, Alibaba, GCP, Azure)
# All routers sit behind 1:1 NAT in dedicated peering subnets.

# --- AWS side (MikroTik CHR "chr-peering" in ap-southeast-1) ---
AWS_PUBLIC_IP=52.76.246.237          # Elastic IP, 1:1 NAT onto ether1
AWS_PEERING_IP=10.29.63.250          # ether1, subnet-ics-nextops-peering-a (10.29.63.240/28)
AWS_PRIVATE_IP=10.29.16.100          # ether2, subnet-ics-nextops-private-a (10.29.16.0/20)
AWS_ASN=65530
AWS_SUPERNET=10.29.0.0/18            # whole NextOps AWS VPC (10.29.0.0/18)

# --- Alibaba side (MikroTik CHR "chr-peering" in ap-southeast-5) ---
ALI_PUBLIC_IP=8.215.24.90            # EIP, 1:1 NAT onto ether1
ALI_PEERING_IP=10.151.63.250         # ether1, nextops-peering-ap-southeast-5a (10.151.63.240/28)
ALI_PRIVATE_IP=10.151.10.100         # ether2, nextops-private-ap-southeast-5a (10.151.10.0/24)
ALI_ASN=65531
ALI_SUPERNET=10.151.0.0/18           # whole NextOps Alibaba VPC (10.151.0.0/18)

# --- GCP side (MikroTik CHR "chr-peering" in asia-southeast2) ---
GCP_PUBLIC_IP=34.101.118.166         # static external IP, 1:1 NAT onto nic0/ether1
GCP_PEERING_IP=10.101.16.10          # ether1, nextops-peering-apse2-subnet (10.101.16.0/28)
GCP_PRIVATE_IP=10.101.0.10           # ether2, nextops-prod-apse2-subnet (10.101.0.0/22)
GCP_ASN=65532
GCP_SUPERNET=10.101.0.0/16           # whole NextOps GCP Shared VPC

# --- Azure side (MikroTik CHR "chr-peering" in indonesiacentral) ---
AZURE_PUBLIC_IP=70.153.184.179       # pip-chr-peering, 1:1 NAT onto ether1
AZURE_PEERING_IP=10.126.63.250       # ether1, subnet-peering (10.126.63.240/28)
AZURE_PRIVATE_IP=10.126.1.100        # ether2, subnet-private (10.126.1.0/24)
AZURE_ASN=65533
AZURE_SUPERNET=10.126.0.0/18         # whole NextOps Azure VNet

# --- Tunnel Segments (/30 Link-Local Point-to-Point) ---
# Alibaba <-> GCP
ALI_GCP_TUNNEL_ALI_IP=169.254.100.1
ALI_GCP_TUNNEL_GCP_IP=169.254.100.2
ALI_GCP_TUNNEL_NETWORK=169.254.100.0

# Azure <-> GCP
AZURE_GCP_TUNNEL_AZURE_IP=169.254.101.1
AZURE_GCP_TUNNEL_GCP_IP=169.254.101.2
AZURE_GCP_TUNNEL_NETWORK=169.254.101.0

# Azure <-> Alibaba
AZURE_ALI_TUNNEL_AZURE_IP=169.254.102.1
AZURE_ALI_TUNNEL_ALI_IP=169.254.102.2
AZURE_ALI_TUNNEL_NETWORK=169.254.102.0

# AWS <-> Alibaba
AWS_ALI_TUNNEL_AWS_IP=169.254.103.1
AWS_ALI_TUNNEL_ALI_IP=169.254.103.2
AWS_ALI_TUNNEL_NETWORK=169.254.103.0

# AWS <-> GCP
AWS_GCP_TUNNEL_AWS_IP=169.254.104.1
AWS_GCP_TUNNEL_GCP_IP=169.254.104.2
AWS_GCP_TUNNEL_NETWORK=169.254.104.0

# AWS <-> Azure
AWS_AZURE_TUNNEL_AWS_IP=169.254.105.1
AWS_AZURE_TUNNEL_AZURE_IP=169.254.105.2
AWS_AZURE_TUNNEL_NETWORK=169.254.105.0

# Tunnel MTU and TCP MSS
TUNNEL_MTU=1400
TUNNEL_MSS=1360

TIMEZONE=Asia/Jakarta

# --- Pre-Shared Keys (Set secure random strings) ---
IPSEC_PSK_ALI_GCP=CHANGE_ME_RANDOM_SECRET_1
IPSEC_PSK_AZURE_GCP=CHANGE_ME_RANDOM_SECRET_2
IPSEC_PSK_AZURE_ALI=CHANGE_ME_RANDOM_SECRET_3
IPSEC_PSK_AWS_ALI=CHANGE_ME_RANDOM_SECRET_4
IPSEC_PSK_AWS_GCP=CHANGE_ME_RANDOM_SECRET_5
IPSEC_PSK_AWS_AZURE=CHANGE_ME_RANDOM_SECRET_6
